---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  title: string;
  heroImage?: ImageMetadata;
}

const { title, heroImage } = Astro.props;
---

<header class="-mt-16 mb-8 overflow-hidden">
  <div class="grid h-36 grid-rows-[4rem_auto] lg:h-60">
    {
      heroImage && (
        <div class="relative col-span-full row-span-full">
          <Image
            src={heroImage}
            alt=""
            class="absolute object-center object-cover brightness-90 dark:brightness-30 h-full"
            widths={[640, 960, 1280]}
            sizes="(min-width: 768px) 720px, 100vw"
            format="webp"
          />
        </div>
      )
    }
    <div class="relative col-span-full row-[2/-1] flex flex-col justify-center">
      <div class="content-container overflow-hidden">
        {
          title && (
            <h1 class="text-2xl font-bold text-white text-shadow-lg lg:text-6xl dark:text-neutral-200">{title}</h1>
          )
        }
        <div class="min-h-4 font-semibold text-white text-shadow-black/40 text-shadow-xs md:min-h-8">
          <slot />
        </div>
      </div>
    </div>
  </div>
</header>
